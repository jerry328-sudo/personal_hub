{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-hub",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-hub-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "personal-hub-media-local"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // 必须使用独立 namespace_id：共用命名空间的绑定会共享计数器。
      "name": "READER_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "vars": {
    "APP_ORIGIN": "http://localhost:5173",
    "SESSION_TTL_SECONDS": "604800"
  },
  "secrets": {
    "required": ["ADMIN_LOGIN_SECRET", "AUTH_PEPPER"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "production": {
      "name": "personal-hub-production",
      "account_id": "3cac11b1edee39fd49d98b0a808d6471",
      "workers_dev": false,
      "routes": [{ "pattern": "personal-hub.echem.ai", "custom_domain": true }],
      "preview_urls": false,
      "d1_databases": [{
        "binding": "DB",
        "database_name": "personal-hub-production",
        "database_id": "93a3fde0-6930-40a3-a983-775a707c1851",
        "migrations_dir": "migrations"
      }],
      "r2_buckets": [{
        "binding": "MEDIA",
        "bucket_name": "personal-hub-media-production"
      }],
      "ratelimits": [{
        "name": "LOGIN_RATE_LIMITER",
        "namespace_id": "918202601",
        "simple": { "limit": 10, "period": 60 }
      }, {
        "name": "READER_RATE_LIMITER",
        "namespace_id": "918202602",
        "simple": { "limit": 120, "period": 60 }
      }],
      "vars": {
        "APP_ORIGIN": "https://personal-hub.echem.ai",
        "SESSION_TTL_SECONDS": "604800"
      },
      "secrets": {
        "required": ["ADMIN_LOGIN_SECRET", "AUTH_PEPPER"]
      }
    }
  }
}
